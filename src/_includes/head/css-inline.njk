
	{%- if eleventy.env.runMode === "serve" %}
		<!-- Dev : feuilles statiques recompilées à part et injectées à chaud, sans reconstruire les pages -->
		<link rel="stylesheet" href="/assets/css/dev/global.css">
		<link rel="stylesheet" href="/assets/css/dev/local.css">
	{%- else  %}
		<!-- Inlined CSS (fastest site performance in production)  -->
		<style>{% getBundle "css", "global" %}</style>
		<style>{% getBundle "css", "local" %}</style>

		{% css "global" %}{% include "css/global.css" %}{% endcss %}
	{%- endif %}
