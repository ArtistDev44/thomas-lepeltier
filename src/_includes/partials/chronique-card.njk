<li
  data-title="{{ item.data.title }}"
  data-search="{{ item.data.title }} {{ item.data.authorFullName or '' }}"
  data-tags="{{ item.data.tags | publicTags | join('|') }}"
  data-year="{{ item.date | anneeConnue }}"
  data-authors="{{ item.data.authorFullName | splitAuteurs | join('|') }}"
  data-sort-author="{{ item.data.authorLastName or '' }}"
>
  <a class="chronique-card" href="{{ item.url | url }}">
    <span class="chronique-card__cover">
      {% if item.data.imageUrl %}{% image item.data.imageUrl, "", "", "lazy", "", "", [160, 320], "96px", ["webp", "jpeg"] %}{% endif %}
    </span>
    <span class="chronique-card__body">
      <span class="chronique-card__title">{{ item.data.title }}</span>
      {% if item.data.authorFullName %}<span class="chronique-card__author">{{ item.data.authorFullName }}</span>{% endif %}
      <span class="cover-card__meta">
        {%- if item.date | anneeConnue %}<span>{{ item.date | anneeConnue }}</span>{% endif -%}
        {%- for tag in item.data.tags | publicTags %}<span class="tag">{{ tag }}</span>{% endfor -%}
      </span>
    </span>
  </a>
</li>
