<footer class="site-footer">
  <div class="wrapper">
    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__name" {{ indicateActiveHome }}>{{ meta.siteName }}</a>
        <p class="site-footer__tagline">
          Docteur en astrophysique, historien et philosophe des sciences. Livres, articles, plus de 500 chroniques
          d’essais et conférences.
        </p>
      </div>

      <div class="site-footer__cols">
        <nav aria-label="Parcourir le site">
          <h2 class="site-footer__title">Parcourir</h2>
          <ul role="list">
            {% for item in navigation.top %}
              {% if item.url != "/" %}
                <li><a href="{{ item.url }}">{{ item.text }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>

        <nav aria-label="{{ meta.navigation.ariaBottom }}">
          <h2 class="site-footer__title">Informations</h2>
          <ul role="list">
            {% for item in navigation.bottom %}
              <li>
                <a href="{{ item.url }}" {{ helpers.getLinkActiveState(item.url, page.url) | safe }}>{{ item.text }}</a>
              </li>
            {% endfor %}
            <li><a href="/liens/">Sites à visiter</a></li>
          </ul>
        </nav>

        <nav aria-label="{{ meta.navigation.ariaPlatforms }}">
          <h2 class="site-footer__title">Suivre</h2>
          <div class="site-footer__social">
            <a
              href="{{ meta.blog.feedLinks[0].url }}"
              rel="alternate"
              type="{{ meta.blog.feedLinks[0].type }}"
              class="button"
              data-icon
              title="Flux RSS des chroniques"
            >
              <span class="visually-hidden">{{ meta.blog.feedLinks[0].title }}</span>
              {% svg "misc/rss" %}
            </a>

            {% for key, value in personal.platforms %}
              {% if value != "" %}
                <a class="no-indicator button" data-icon href="{{ value }}" rel="me" title="{{ key | capitalize }}">
                  <span class="visually-hidden">{{ key | capitalize }}</span>
                  {% svg 'platform/' + key %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </nav>
      </div>
    </div>

    <div class="site-footer__legal">
      <span>&copy; {% year %} {{ meta.siteName }}</span>
      <span class="creator">
        Site réalisé par <a class="no-indicator" href="{{ meta.creator.website }}">{{ meta.creator.name }}</a>
      </span>
    </div>
  </div>
</footer>
