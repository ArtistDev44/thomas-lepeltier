<header class="site-header">
  <a href="#main" class="skip-link">{{ meta.skipContent }}</a>

  <div class="site-header__inner">
    <a href="/" class="logo | cluster" {{ indicateActiveHome }}>
      {% svg "misc/logo" %}

      <span>{{ meta.siteName }}</span>
    </a>

    <div class="site-header__tools">
      {% include "partials/main-nav.njk" %}

      <a
        href="/recherche/"
        class="site-header__search"
        aria-label="Rechercher sur le site"
        title="Rechercher"
        {{ helpers.getLinkActiveState("/recherche/", page.url) | safe }}
      >
        {% svg "misc/search", "", "search-icon" %}
      </a>
    </div>
  </div>
</header>
