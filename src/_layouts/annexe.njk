---
layout: base
---

<div class="wrapper">
  <header class="page-header">
    {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </header>

  <div class="page-body prose flow">{{ content | safe }}</div>
</div>
