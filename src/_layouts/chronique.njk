---
layout: base
---

{% set texteChronique = content | striptags | trim %}

<article data-pagefind-body data-pagefind-filter="section: Chroniques" class="wrapper">
  <header class="page-header">
    <span class="eyebrow">Chronique{% if page.date | anneeConnue %} · {{ page.date | anneeConnue }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if authorFullName %}<p class="lead">{{ authorFullName }}</p>{% endif %}
  </header>

  <div class="book-layout">
    <aside class="book-aside" aria-label="Le livre chroniqué">
      {% include 'partials/couverture.njk' %}

      {% if publication.titre %}
        <dl class="book-facts">
          <div>
            <dt>Chronique parue</dt>
            <dd>
              {% if publication.url %}<a href="{{ publication.url }}" target="_blank" rel="noopener noreferrer">{{ publication.titre }}</a>{% else %}<em>{{ publication.titre }}</em>{% endif %}{% if page.date | anneeConnue %}, {{ page.date | anneeConnue }}{% endif %}
            </dd>
          </div>
        </dl>
      {% endif %}

      {% if amazonLink %}
        <div class="book-buy">
          <a class="button" data-button-variant="primary" href="{{ amazonLink }}" rel="sponsored noopener" target="_blank">Acheter le livre<span class="visually-hidden"> (s’ouvre dans un nouvel onglet)</span></a>
          <p class="book-buy__note">Lien d’affiliation : il me soutient sans surcoût pour vous.</p>
        </div>
      {% endif %}
    </aside>

    <div class="book-main prose flow" data-pagefind-ignore>
      {% if texteChronique.length > 40 %}
        {{ content | safe }}
      {% elif externalLink %}
        <p>Cette chronique a été publiée dans {{ externalLinkSource or "un autre média" }}.</p>
        <p>
          <a class="button" data-button-variant="primary" href="{{ externalLink }}" target="_blank" rel="noopener noreferrer">Lire la chronique<span class="visually-hidden"> (s’ouvre dans un nouvel onglet)</span></a>
        </p>
      {% else %}
        <p><em>Cette chronique est en préparation.</em></p>
      {% endif %}

      <p class="chronique-signature">Chronique de Thomas Lepeltier</p>
    </div>
  </div>
</article>
