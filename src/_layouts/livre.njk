---
layout: base
---

<div data-pagefind-body data-pagefind-filter="section: Livres" class="region wrapper flow prose" style="--region-space-top: var(--space-xl-2xl)">
  <h1 class="gradient-text">Présentation du livre {{ title }}</h1>

  <h2>Fiche technique</h2>
{% if page.date | anneeConnue %}<p>Date de commercialisation : {{ page.date | anneeConnue }}</p>{% endif %}
{% if nombre_de_pages %}<p>Nombre de pages : {{ nombre_de_pages }}</p>{% endif %}
{% if prix %}<p>Prix en euro : {{ prix }}</p>{% endif %}
{% if edition_nom %}<p>Éditeur : {% if edition_lien %}<a href="{{ edition_lien }}">{{ edition_nom }}</a>{% else %}{{ edition_nom }}{% endif %}</p>{% endif %}
<div>

    {% include 'partials/livre3D.njk' %}
  <div data-pagefind-ignore>
      {{ content | lettrine | safe }}
  </div>
  </div>

  {% if critiques %}
    {% set headingLevel = "h3" %}
    {% include 'partials/commentaires.njk' %}
  {% endif %}

{% if liens_achat and liens_achat.length %}
<div class="flow prose">
{% for lien in liens_achat %}
<a class="button" href="{{ lien }}" rel="sponsored noopener" target="_blank">{% if loop.first %}Soutenez-moi en achetant ce livre{% else %}Autre librairie{% endif %}</a>
{% endfor %}
</div>
{% endif %}
</div>
<style>

@layer global {
  h1 {
    font-size: var(--size-step-4) !important;
  }
}
    p.author_cr {
        text-align: right;
    }

    .image-left {
      float: left;
      margin-right: 15px;
    }

@media (min-width: 600px) {
  img {
    width: 30vw;
    height: auto;
  }
}
</style>
