---
layout: base
---

<div data-pagefind-body class="wrapper">
  <header class="page-header">
    {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </header>

  <div data-pagefind-ignore class="page-body prose flow{% if narrow %} page-body--narrow{% endif %}">
    {{ content | safe }}
  </div>
</div>
