---
layout: base
---

<div {% if nosearch %}data-pagefind-ignore{% else %}data-pagefind-body data-pagefind-filter="section: {% if page.url and '/annexes/' in page.url %}Annexes{% else %}Pages{% endif %}"{% endif %} class="wrapper">
  <header class="page-header">
    {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </header>

  <div class="page-body prose flow{% if narrow %} page-body--narrow{% endif %}">
    {{ content | safe }}
  </div>
</div>
