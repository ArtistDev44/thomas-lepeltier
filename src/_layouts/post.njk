---
layout: base
schema: BlogPosting
---

<article data-pagefind-body data-pagefind-filter="section: Articles" class="wrapper">
  {% include "partials/search-index.njk" %}
  <header class="page-header">
    <span class="eyebrow">Article{% if date | anneeConnue %} · {{ date | anneeConnue }}{% endif %}</span>
    <h1>{{ title }}</h1>
    {% if tags | publicTags | length %}
      <p class="tag-list">
        {% for tag in tags | publicTags %}
          <a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>
        {% endfor %}
      </p>
    {% endif %}
  </header>

  <div class="page-body prose flow">
    {% if image %}
      {%
        imageKeys {
          "src": image,
          "alt": alt or "",
          "credit": credit,
          "loading": "eager",
          "containerClass": "feature"
        }
      %}
    {% endif %}
    {{ content | safe }}
  </div>

  <!--  h-card infos: https://indieweb.org/authorship -->
  <div hidden class="h-entry" data-pagefind-ignore>
    <a class="u-url" href="{{ page.url | url | absoluteUrl(meta.url) }}">{{ title }}</a>
    <a class="p-name u-url" rel="author" href="{{ meta.url }}">{{ meta.author.name }}</a>
    <img
      eleventy:ignore
      class="u-author h-card"
      src="{{ meta.author.avatar | url | absoluteUrl(meta.url) }}"
      alt="{{ meta.author.name }}"
    />
  </div>
</article>

{%- css "local" -%}
  {%- include 'css/post.css' -%}
  {%- include 'css/footnotes.css' -%}
{%- endcss -%}
