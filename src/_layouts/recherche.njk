---
layout: base
---

<div class="wrapper">
  <header class="page-header">
    <span class="eyebrow">Recherche</span>
    <h1>{{ title }}</h1>
    <p class="lead">Cherchez un livre, un article, une chronique ou un auteur. Les résultats se mettent à jour pendant la saisie.</p>
  </header>

  <div class="page-body search-page">
    <pagefind-input></pagefind-input>
    <pagefind-filter-pane></pagefind-filter-pane>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
    {{ content | safe }}
  </div>
</div>
