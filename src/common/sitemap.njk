---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
excludeFromSitemap: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in collections.showInSitemap %}
    {% if page.url and page.data.excludeFromSitemap != true %}

      {# `lastmod` n'est publié que pour une vraie date de mise à jour (`lastUpdated`) : `page.date` est la date de parution du livre ou de l'article, pas celle de la page #}
      <url>
        <loc>{{ meta.url }}{{ page.url }}</loc>
        {% if page.data.lastUpdated %}<lastmod>{{ page.data.lastUpdated | toIsoString }}</lastmod>{% endif %}
        <changefreq>{{ page.data.changeFreq if page.data.changeFreq else "monthly" }}</changefreq>
    </url>
    {% endif %}
  {% endfor %}
</urlset>
