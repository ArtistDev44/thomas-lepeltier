---
layout: tags
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: '{{ meta.blog.tagSingle }} : {{ tag }}'
---

<ul class="chronique-list" role="list">
  {% set itemList = collections[tag] | reverse %}
  {% asyncEach item in itemList %}
    {% include "partials/chronique-card.njk" %}
  {% endeach %}
</ul>

<section class="page-section" aria-labelledby="autres-rubriques">
  <h2 id="autres-rubriques" class="text-step-2">{{ meta.blog.tagMore }}</h2>

  <ul class="tag-list" role="list">
    {% for t in collections.tagList | publicTags %}
      <li>
        <a
          href="/tags/{{ t | slugify }}/"
          class="tag"
          {{ helpers.getLinkActiveState('/tags/' + t | slugify + '/', page.url) | safe }}
        >
          {{ t }}
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
